<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Signunder</PackageId>
    <Description>Client for the SignUnder API: sign AI-generated content with C2PA Content Credentials under your own name, verify it, and read the registry record.</Description>
